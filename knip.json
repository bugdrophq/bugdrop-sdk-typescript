{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "vitest.config.ts",
        "test/staging/*.test.mjs",
        "scripts/staging/worker.mjs",
        "scripts/staging/observer.mjs",
        "examples/opt-in-backend/handler.ts",
        "examples/opt-in-backend/transport.ts"
      ],
      "project": [
        "scripts/**/*.mjs",
        "test/**/*.ts",
        "*.{ts,mjs}",
        "test/staging/**/*.mjs",
        "examples/opt-in-backend/*.ts"
      ],
      "ignoreDependencies": ["@bugdrop/server", "@bugdrop/browser"]
    },
    "packages/browser": {
      "entry": ["src/index.ts", "src/opt-in.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/index.ts", "src/browser.ts", "src/opt-in.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
