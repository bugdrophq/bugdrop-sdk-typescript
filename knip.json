{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "vitest.config.ts",
        "test/staging/*.test.mjs",
        "scripts/staging/worker.mjs",
        "scripts/staging/observer.mjs"
      ],
      "project": ["scripts/**/*.mjs", "test/**/*.ts", "*.{ts,mjs}", "test/staging/**/*.mjs"],
      "ignoreDependencies": ["@bugdrop/server"]
    },
    "packages/browser": {
      "entry": ["src/index.ts", "src/opt-in.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/index.ts", "src/browser.ts", "src/opt-in.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
