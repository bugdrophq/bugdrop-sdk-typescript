{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "test/staging/*.test.mjs",
        "scripts/staging/worker.mjs",
        "scripts/staging/observer.mjs",
        "examples/opt-in-backend/handler.ts",
        "examples/opt-in-backend/transport.ts",
        "examples/v1-backend/handler.ts",
        "examples/v1-backend/transport.ts",
        "examples/v1-backend/loopback-server.ts",
        "examples/v1-backend/loopback-browser.ts",
        "examples/hosted-fixture/worker.ts",
        "examples/beta-consumer/browser.ts",
        "examples/beta-consumer/server.ts"
      ],
      "project": [
        "scripts/**/*.mjs",
        "test/**/*.ts",
        "*.{ts,mjs}",
        "test/staging/**/*.mjs",
        "examples/opt-in-backend/*.ts",
        "examples/v1-backend/*.ts",
        "examples/hosted-fixture/*.ts",
        "examples/beta-consumer/*.ts"
      ]
    },
    "packages/browser": {
      "entry": ["src/index.ts", "src/opt-in.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/index.ts", "src/browser.ts", "src/opt-in.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
