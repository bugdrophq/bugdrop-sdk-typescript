{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "vitest.config.ts"],
      "project": ["scripts/**/*.mjs", "test/**/*.ts", "*.{ts,mjs}"]
    },
    "packages/browser": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/index.ts", "src/browser.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
