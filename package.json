{
  "name": "bugdrop-sdk-typescript",
  "version": "0.0.0-development",
  "private": true,
  "description": "Official TypeScript SDK workspace for BugDrop",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "build": "npm run build -w @bugdrop/contracts && npm run build -w @bugdrop/browser && npm run build -w @bugdrop/server",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm run audit && npm run check:workflows",
    "check:workflows": "node scripts/check-workflows.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run -w @bugdrop/browser && npm pack --dry-run -w @bugdrop/server",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:security": "npm run build && node scripts/verify-browser-boundary.mjs",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "validate": "npm run check && npm run test:coverage && npm run test:security && npm run pack:check && node scripts/integration.mjs && npm run test:staging:unit",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "test:integration:service": "npm run build && node scripts/integration.mjs --service",
    "test:staging": "npm run build && node scripts/staging.mjs",
    "test:staging:unit": "node --test test/staging/*.test.mjs",
    "validate:dogfood": "npm run validate && npm run test:staging"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "16.5.0",
    "jsdom": "29.0.1",
    "knip": "5.76.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
