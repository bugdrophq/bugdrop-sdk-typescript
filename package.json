{
  "name": "bugdrop-sdk-typescript",
  "version": "0.0.0-development",
  "private": true,
  "description": "Official TypeScript SDK workspace for BugDrop",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "build": "npm run build -w @bugdrop/contracts && npm run build -w @bugdrop/browser && npm run build -w @bugdrop/server",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:security": "npm run build && node scripts/verify-browser-boundary.mjs",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:security"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "jsdom": "29.0.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
