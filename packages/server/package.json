{
  "name": "@bugdrop/server",
  "version": "0.1.0",
  "description": "Server-only capability exchange client for BugDrop",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm,cjs --dts --sourcemap --clean --target node20 --platform node",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
